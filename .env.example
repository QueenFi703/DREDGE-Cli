# DREDGE Studio - Environment Configuration
# Copy this to .env and fill in your credentials

# ============================================================================
# Flask Configuration
# ============================================================================

FLASK_ENV=production
FLASK_DEBUG=0

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-minimum-32-characters

# ============================================================================
# GitHub OAuth
# ============================================================================

# 1. Go to: https://github.com/settings/developers
# 2. Click "New OAuth App"
# 3. Fill Application Details:
#    - Application name: DREDGE Studio
#    - Homepage URL: http://localhost:3000
#    - Authorization callback URL: http://localhost:3000/auth/github/callback
# 4. Copy Client ID and Client Secret below

GITHUB_CLIENT_ID=your-github-client-id-here
GITHUB_CLIENT_SECRET=your-github-client-secret-here

# ============================================================================
# Google OAuth
# ============================================================================

# 1. Go to: https://console.developers.google.com/
# 2. Create new project
# 3. Enable "Google+ API"
# 4. Go to Credentials → OAuth 2.0 Client ID
# 5. Choose "Web Application"
# 6. Add authorized redirect URI:
#    http://localhost:3000/auth/google/callback
# 7. Copy Client ID and Secret below

GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ============================================================================
# OAuth Configuration
# ============================================================================

# Redirect base URL for OAuth callbacks
# Use http://localhost:3000 for local development
# Use https://your-domain.com for production
OAUTH_REDIRECT_BASE=http://localhost:3000

# ============================================================================
# Server Configuration
# ============================================================================

# Server host (0.0.0.0 = all interfaces, 127.0.0.1 = localhost only)
FLASK_HOST=0.0.0.0
FLASK_PORT=3000

# ============================================================================
# Optional: Database (for persistent user storage)
# ============================================================================

# DATABASE_URL=sqlite:///dredge.db
# or
# DATABASE_URL=postgresql://user:pass@localhost/dredge

# ============================================================================
# Notes
# ============================================================================

# After filling this file:
# 1. Save as .env in dredge-cli-repo/
# 2. Run: export $(cat .env | xargs)
# 3. Run: python -m dredge.server
# 4. Visit: http://localhost:3000/auth/login
