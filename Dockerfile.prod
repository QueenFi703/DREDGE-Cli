# Production Dockerfile - Multi-stage build optimized
FROM python:3.11-slim as builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip install --user --no-cache-dir -r requirements.txt

# Production image
FROM python:3.11-slim

WORKDIR /app

# Create non-root user for security
RUN useradd -m -u 1000 appuser

# Copy Python dependencies from builder
COPY --from=builder /root/.local /home/appuser/.local

# Copy application code
COPY unified_auth_gateway.py .
COPY unified_auth_middleware.py .
COPY api_key_manager.py .
COPY fastapi_auth_middleware.py .

# Create data directory with proper permissions
RUN mkdir -p /app/data && chown -R appuser:appuser /app

# Set environment variables
ENV PATH=/home/appuser/.local/bin:$PATH
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import httpx; httpx.get('http://localhost:9000/health', timeout=5)" || exit 1

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 9000

# Start application
CMD ["uvicorn", "unified_auth_gateway:app", "--host", "0.0.0.0", "--port", "9000", "--workers", "4"]
