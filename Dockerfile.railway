# Railway.app optimized DREDGE production build
# Keep the runtime process model explicit: start.sh owns the MCP child and
# the foreground Orion Gateway process. Do not define a second CMD here.

FROM python:3.14-slim AS builder

ENV PYTHONPATH="/app/src:${PYTHONPATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
COPY pyproject.toml ./
COPY src/ ./src/

RUN python -m venv /opt/venv && \
    . /opt/venv/bin/activate && \
    pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt && \
    pip install .

FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PORT=8000 \
    FLASK_ENV=production \
    PYTHONPATH="/app/src:${PYTHONPATH}" \
    PATH="/opt/venv/bin:$PATH" \
    VIRTUAL_ENV="/opt/venv"

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
COPY src/ ./src/
COPY wsgi.py .
COPY README.md LICENSE ./
COPY start.sh .

RUN chmod +x start.sh && \
    useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app

USER appuser

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:${PORT}/health" || exit 1

EXPOSE 8000

# Single process supervisor. start.sh launches the MCP child and keeps the
# Orion Gateway as the sole foreground process for Railway health/restarts.
CMD ["./start.sh"]
