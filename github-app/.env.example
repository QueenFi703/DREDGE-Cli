# GitHub App credentials (required)
GITHUB_APP_ID=123456
GITHUB_APP_INSTALLATION_ID=12345678

# Paste the raw PEM content (newlines are supported via \n or literal multi-line)
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
MIIEowIBAAKCAQEA...
...
-----END RSA PRIVATE KEY-----"

# Server port (optional, default: 3003)
PORT=3003
